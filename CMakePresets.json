{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 27,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/build/install/${presetName}"
		},
		{
			"name": "Win64-Base",
			"hidden": true,
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"cacheVariables": {
				"OpenCV_DIR": "C:/opencv/build"
			}
		},
		{
			"name": "Win64",
			"displayName": "Windows x64",
			"description": "Windows x64 configuration with Debug, Release, and RelWithDebInfo (multi-config generator).",
			"inherits": "Win64-Base",
			"generator": "Visual Studio 17 2022",
			"architecture": {
				"value": "x64",
				"strategy": "set"
			}
		},
		{
			"name": "Win64-Ninja",
			"displayName": "Windows x64 Ninja Debug",
			"description": "MSVC with Ninja, mainly to generate compile_commands.json for clangd. Requires an x64 VS developer shell (see scripts/configure-clangd.ps1).",
			"inherits": "Win64-Base",
			"generator": "Ninja",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_CXX_COMPILER": "cl.exe"
			}
		},
		{
			"name": "Linux64",
			"hidden": true,
			"inherits": "base",
			"generator": "Ninja",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		},
		{
			"name": "Linux64-Debug",
			"displayName": "Linux x64 Debug",
			"description": "Linux x64 Debug configuration.",
			"inherits": "Linux64",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "Linux64-Release",
			"displayName": "Linux x64 Release",
			"description": "Linux x64 Release configuration.",
			"inherits": "Linux64",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "Linux64-RelWithDebInfo",
			"displayName": "Linux x64 RelWithDebInfo",
			"description": "Linux x64 Release configuration with debug info.",
			"inherits": "Linux64",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo"
			}
		}
	],
	"buildPresets": [
		{
			"name": "Win64-Debug",
			"configurePreset": "Win64",
			"configuration": "Debug"
		},
		{
			"name": "Win64-Release",
			"configurePreset": "Win64",
			"configuration": "Release"
		},
		{
			"name": "Win64-RelWithDebInfo",
			"configurePreset": "Win64",
			"configuration": "RelWithDebInfo"
		},
		{
			"name": "Win64-Ninja",
			"configurePreset": "Win64-Ninja"
		},
		{
			"name": "Linux64-Debug",
			"configurePreset": "Linux64-Debug"
		},
		{
			"name": "Linux64-Release",
			"configurePreset": "Linux64-Release"
		},
		{
			"name": "Linux64-RelWithDebInfo",
			"configurePreset": "Linux64-RelWithDebInfo"
		}
	]
}
