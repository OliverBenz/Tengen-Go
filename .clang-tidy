# Bugs first: widen the checks once these are clean.
# Off: swappable parameters flags every two parameters of one type, enum size gains nothing,
# and VirtualCall only fires inside asio, where the header filter can't hide it.
Checks: >
  -*,
  bugprone-*,
  concurrency-*,
  clang-analyzer-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -performance-enum-size,
  -clang-analyzer-optin.cplusplus.VirtualCall

# Only report our own headers, not Qt, asio, OpenCV or anything under build/.
HeaderFilterRegex: '.*/(src|tests)/.*'
ExcludeHeaderFilterRegex: '.*/build/.*'
